rules_version = '2';
// Decibel-114 security rules. Paste into Firebase console → Firestore → Rules → Publish.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function prof() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    function hasRole(roles) {
      return signedIn() && exists(/databases/$(db)/documents/users/$(request.auth.uid))
        && prof().role in roles && prof().get('disabled', false) != true;
    }
    function isAdmin()   { return hasRole(['admin']); }
    function isCatalog() { return hasRole(['admin', 'manager']); }
    function isSales()   { return hasRole(['admin', 'manager', 'sales']); }
    function isStaff()   { return hasRole(['admin', 'manager', 'sales', 'support']); }
    function onlyKeys(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // Public store configuration and catalog
    match /settings/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /categories/{id} { allow read: if true; allow write: if isCatalog(); }
    match /products/{id} {
      allow read: if resource.data.status == 'active' || isStaff();
      allow write: if isCatalog();
    }
    // Promo codes: checkout looks one up by its exact code
    match /coupons/{code} {
      allow get: if true;
      allow list, write: if isCatalog();
    }

    // Orders: guests and customers create; customers read their own; sales team manages
    match /orders/{id} {
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.paymentStatus == 'pending'
                    && (request.resource.data.uid == null || (signedIn() && request.resource.data.uid == request.auth.uid))
                    && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 50;
      allow read: if isSales() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isSales();
      allow delete: if isAdmin();
    }
    match /tracking/{no} {
      allow get: if true;
      allow list: if false;
      allow create: if request.resource.data.status == 'pending';
      allow update, delete: if isSales();
    }

    // Leads / quote requests and CRM notes
    match /quotes/{id} {
      allow create: if request.resource.data.status == 'new' && request.resource.data.items is string && request.resource.data.items.size() < 4000;
      allow read, update: if isSales();
      allow delete: if isAdmin();
    }
    match /crm/{key} { allow read, write: if isSales(); }

    // Website chat. The chat id is a long random secret held by the visitor's browser.
    match /chats/{chatId} {
      allow get: if true;
      allow list: if isStaff();
      allow create: if request.resource.data.status == 'ai' && request.resource.data.unreadStaff == 0;
      allow update: if isStaff()
        || (onlyKeys(['lastMessage', 'lastFrom', 'updatedAt', 'unreadStaff', 'status', 'name', 'phone'])
            && request.resource.data.status in ['ai', 'waiting', 'open']);
      allow delete: if isAdmin();
      match /messages/{m} {
        allow read: if true;
        allow create: if request.resource.data.from in ['customer', 'ai', 'system']
                      || (request.resource.data.from == 'agent' && isStaff());
        allow update, delete: if isAdmin();
      }
    }

    // People: users edit their own profile (never role or disabled); sales can read; admins manage
    match /users/{uid} {
      allow read: if isSales() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin() || (signedIn() && request.auth.uid == uid && request.resource.data.role == 'customer');
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
                      && request.resource.data.role == resource.data.role
                      && request.resource.data.get('disabled', false) == resource.data.get('disabled', false));
      allow delete: if isAdmin();
    }
  }
}
