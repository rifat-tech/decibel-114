# ── Firebase (Project settings → General → Your apps → Web app config) ──
# Leave these empty to run in DEMO MODE (sample data stored in the browser).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Cloudinary (free image hosting for product photos) ──
# Settings → Upload → Upload presets → add an UNSIGNED preset
VITE_CLOUDINARY_CLOUD=
VITE_CLOUDINARY_PRESET=

# ── Business details (shown on the site; empty = hidden) ──
VITE_PHONE=
VITE_WHATSAPP=
VITE_EMAIL=info@gigexa.com.bd
VITE_ADDRESS=
VITE_HOURS=Sat–Thu, 10am to 8pm
VITE_BKASH=
VITE_NAGAD=
VITE_BANK=
